VITE_API_URL=https://elocation-backend-production.up.railway.app

# Laisser VIDE tant que le backend Railway n'expose pas de gateway WebSocket.
# Vérifié le 2026-07-23 : /socket.io/ renvoie 404 et wss:// refuse le handshake.
# Une fois la gateway déployée, mettre :
# VITE_WS_URL=wss://elocation-backend-production.up.railway.app
VITE_WS_URL=

VITE_VAPID_PUBLIC_KEY=

# Adresse publique du site, utilisee pour les liens partages.
# Vide = window.location.origin (correct en production, « localhost » en dev).
VITE_SITE_URL=https://e-location-nu.vercel.app
